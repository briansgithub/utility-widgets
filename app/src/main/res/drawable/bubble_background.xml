<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="0dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#33000000" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="0dp"
        android:right="1dp"
        android:top="0dp">
        <shape android:shape="oval">
            <solid android:color="@color/teal" />
            <stroke
                android:width="2dp"
                android:color="@color/cream" />
        </shape>
    </item>
</layer-list>
